    {
      "id": "rec_poached_pear_oat_porridge",
      "title": "Creamy Oat & Poached Pear Almond Porridge",
      "category": "Breakfast",
      "prepTimeMinutes": 12,
      "servings": 1,
      "imageUrl": "/src/assets/images/recipe_oat_porridge_1794746823540.jpg",
      "ingredients": [
        {
          "raw": "1/2 cup rolled oats",
          "quantity": "1/2",
          "unit": "cup",
          "normalized": "oats"
        },
        {
          "raw": "1 cup unsweetened almond milk",
          "quantity": "1",
          "unit": "cup",
          "normalized": "almond milk"
        },
        {
          "raw": "1 medium poached pear, peeled and sliced",
          "quantity": "1",
          "unit": "medium",
          "normalized": "pear"
        },
        {
          "raw": "1 tbsp smooth almond butter",
          "quantity": "1",
          "unit": "tbsp",
          "normalized": "almond butter"
        },
        {
          "raw": "1/4 tsp ground cinnamon",
          "quantity": "1/4",
          "unit": "tsp",
          "normalized": "ground cinnamon"
        }
      ],
      "instructions": [
        "Combine rolled oats and unsweetened almond milk in a small saucepan over gentle medium-low heat.",
        "Simmer for 6–8 minutes, stirring occasionally, until creamy and very soft.",
        "Top with peeled poached pear slices, smooth almond butter swirl, and a pinch of cinnamon."
      ],
      "dietaryTags": [
        "Soft Texture",
        "Dairy-Free",
        "Low-Acid",
